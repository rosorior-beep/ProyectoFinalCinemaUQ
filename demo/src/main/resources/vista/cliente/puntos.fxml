<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.cinemauq.vistacontrolador.cliente.PuntosVistaControlador"
      spacing="14" styleClass="seccion">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <Label text="Mis puntos CinemaUQ" styleClass="titulo"/>
    <Label fx:id="lblRegla" wrapText="true" styleClass="descripcion"/>
    <HBox spacing="14">
        <VBox spacing="4" styleClass="tarjeta, kpi" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Puntos vigentes" styleClass="kpi-titulo"/>
            <Label fx:id="lblVigentes" styleClass="kpi-valor"/>
        </VBox>
        <VBox spacing="4" styleClass="tarjeta, kpi" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Vencen en los próximos 30 días" styleClass="kpi-titulo"/>
            <Label fx:id="lblPorVencer" styleClass="kpi-valor"/>
        </VBox>
        <VBox spacing="4" styleClass="tarjeta, kpi" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Puntos vencidos sin usar" styleClass="kpi-titulo"/>
            <Label fx:id="lblVencidos" styleClass="kpi-valor"/>
        </VBox>
    </HBox>
    <HBox spacing="16">
        <VBox spacing="10" styleClass="tarjeta" HBox.hgrow="ALWAYS">
            <Label text="Mis lotes de puntos" styleClass="subtitulo"/>
            <TableView fx:id="tablaLotes" prefHeight="260">
                <placeholder><Label text="Aún no has acumulado puntos."/></placeholder>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colLoteObtenidos" text="Obtenidos" prefWidth="90"/>
                    <TableColumn fx:id="colLoteVencen" text="Vencen" prefWidth="90"/>
                    <TableColumn fx:id="colLotePuntos" text="Puntos" prefWidth="60"/>
                    <TableColumn fx:id="colLoteDisponibles" text="Disponibles" prefWidth="80"/>
                    <TableColumn fx:id="colLoteEstado" text="Estado" prefWidth="90"/>
                    <TableColumn fx:id="colLoteOrigen" text="Origen" prefWidth="70"/>
                </columns>
            </TableView>
        </VBox>
        <VBox spacing="10" styleClass="tarjeta" HBox.hgrow="ALWAYS">
            <Label text="¿Qué puedo redimir?" styleClass="subtitulo"/>
            <TableView fx:id="tablaEquivalencias" prefHeight="260">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colEqBeneficio" text="Beneficio" prefWidth="220"/>
                    <TableColumn fx:id="colEqPuntos" text="Puntos" prefWidth="80"/>
                    <TableColumn fx:id="colEqValor" text="Valor en pesos" prefWidth="110"/>
                </columns>
            </TableView>
            <Label text="Redime al comprar: marca &quot;Usar pts&quot; en el resumen de la compra." styleClass="descripcion" wrapText="true"/>
        </VBox>
    </HBox>
    <Label text="Movimientos de puntos" styleClass="subtitulo"/>
    <TableView fx:id="tablaMovimientos" prefHeight="240">
        <placeholder><Label text="Sin movimientos."/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colMovFecha" text="Fecha" prefWidth="130"/>
            <TableColumn fx:id="colMovTipo" text="Tipo" prefWidth="170"/>
            <TableColumn fx:id="colMovPuntos" text="Puntos" prefWidth="80"/>
            <TableColumn fx:id="colMovDetalle" text="Detalle" prefWidth="300"/>
        </columns>
    </TableView>
</VBox>
