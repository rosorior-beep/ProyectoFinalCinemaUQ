<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.cinemauq.vistacontrolador.cliente.TarjetaVistaControlador"
      spacing="14" styleClass="seccion">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <Label text="Mi tarjeta virtual" styleClass="titulo"/>
    <Label wrapText="true" styleClass="descripcion"
           text="Solo el administrador puede recargar tu tarjeta. Envía una solicitud y te notificaremos cuando sea aprobada."/>
    <HBox spacing="16">
        <VBox spacing="10" prefWidth="380" maxWidth="380" styleClass="tarjeta-virtual">
            <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="CinemaUQ" styleClass="tarjeta-marca"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblEstado"/>
            </HBox>
            <Label text="Saldo disponible"/>
            <Label fx:id="lblSaldo" styleClass="tarjeta-saldo"/>
            <Label fx:id="lblNumero" styleClass="tarjeta-numero"/>
            <Label fx:id="lblTitular" styleClass="tarjeta-titular"/>
        </VBox>
        <VBox spacing="10" styleClass="tarjeta" HBox.hgrow="ALWAYS">
            <Label text="Solicitar recarga" styleClass="subtitulo"/>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Monto $"/>
                <TextField fx:id="txtMonto" promptText="Ej. 50000"/>
                <Button text="Enviar solicitud" styleClass="btn-primario" onAction="#solicitarRecarga"/>
            </HBox>
            <Label styleClass="descripcion" wrapText="true"
                   text="Montos entre $10.000 y $1.000.000. Solo puedes tener una solicitud pendiente."/>
            <TableView fx:id="tablaSolicitudes" prefHeight="150">
                <placeholder><Label text="No has solicitado recargas."/></placeholder>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colSolFecha" text="Fecha" prefWidth="120"/>
                    <TableColumn fx:id="colSolMonto" text="Monto" prefWidth="90"/>
                    <TableColumn fx:id="colSolEstado" text="Estado" prefWidth="90"/>
                    <TableColumn fx:id="colSolObservacion" text="Observación" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
    <Label text="Movimientos" styleClass="subtitulo"/>
    <TableView fx:id="tablaMovimientos" prefHeight="320" VBox.vgrow="ALWAYS">
        <placeholder><Label text="La tarjeta no tiene movimientos."/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colMovFecha" text="Fecha" prefWidth="130"/>
            <TableColumn fx:id="colMovTipo" text="Tipo" prefWidth="90"/>
            <TableColumn fx:id="colMovDescripcion" text="Descripción" prefWidth="300"/>
            <TableColumn fx:id="colMovValor" text="Valor" prefWidth="110"/>
            <TableColumn fx:id="colMovSaldo" text="Saldo" prefWidth="110"/>
        </columns>
    </TableView>
</VBox>
