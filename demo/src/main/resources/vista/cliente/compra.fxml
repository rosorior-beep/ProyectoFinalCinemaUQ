<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.cinemauq.vistacontrolador.cliente.CompraVistaControlador"
      spacing="14" styleClass="seccion">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <Label text="Comprar entradas" styleClass="titulo"/>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="lblFuncion" styleClass="info-funcion" wrapText="true"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="← Volver a la cartelera" styleClass="btn-secundario" onAction="#volver"/>
    </HBox>
    <HBox spacing="16">
        <VBox spacing="10" styleClass="tarjeta" HBox.hgrow="ALWAYS">
            <Label text="1. Elige tus asientos" styleClass="subtitulo"/>
            <StackPane fx:id="contenedorMapa"/>
            <Label fx:id="lblPrecios" styleClass="descripcion" wrapText="true"/>
        </VBox>
        <VBox spacing="14" prefWidth="400" minWidth="380">
            <VBox spacing="10" styleClass="tarjeta">
                <Label text="2. Confitería (opcional)" styleClass="subtitulo"/>
                <GridPane fx:id="gridConfiteria" hgap="10" vgap="6"/>
            </VBox>
            <VBox spacing="10" styleClass="tarjeta">
                <Label text="3. Resumen y pago" styleClass="subtitulo"/>
                <VBox fx:id="panelResumen" spacing="8"/>
            </VBox>
        </VBox>
    </HBox>
</VBox>
