<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.cinemauq.vistacontrolador.admin.PromocionesVistaControlador"
      spacing="14" styleClass="seccion">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <Label text="Promociones" styleClass="titulo"/>
    <Label wrapText="true" styleClass="descripcion"
           text="Descuentos por porcentaje según el día de la FUNCIÓN. No son acumulables: se aplica la de mayor porcentaje."/>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <TableView fx:id="tablaPromociones" HBox.hgrow="ALWAYS">
            <placeholder><Label text="No hay promociones."/></placeholder>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colId" text="Id" prefWidth="70"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="170"/>
                <TableColumn fx:id="colAplica" text="Aplica a" prefWidth="110"/>
                <TableColumn fx:id="colDescuento" text="Descuento" prefWidth="80"/>
                <TableColumn fx:id="colDia" text="Día" prefWidth="90"/>
                <TableColumn fx:id="colVigencia" text="Vigencia" prefWidth="170"/>
                <TableColumn fx:id="colActiva" text="Activa" prefWidth="60"/>
            </columns>
        </TableView>
        <VBox spacing="10" prefWidth="360" minWidth="340" styleClass="tarjeta">
            <Label text="Nueva promoción" styleClass="subtitulo"/>
            <GridPane hgap="10" vgap="8">
                <Label text="Nombre" styleClass="etiqueta-form" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS"/>
                <Label text="Aplica a" styleClass="etiqueta-form" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cbAplica" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Descuento %" styleClass="etiqueta-form" GridPane.rowIndex="2"/>
                <TextField fx:id="txtPorcentaje" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Día" styleClass="etiqueta-form" GridPane.rowIndex="3"/>
                <ComboBox fx:id="cbDia" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="Desde" styleClass="etiqueta-form" GridPane.rowIndex="4"/>
                <DatePicker fx:id="dpInicio" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <Label text="Hasta" styleClass="etiqueta-form" GridPane.rowIndex="5"/>
                <DatePicker fx:id="dpFin" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            </GridPane>
            <Button text="Crear promoción" styleClass="btn-primario" onAction="#crearPromocion"/>
            <Button text="Activar / desactivar seleccionada" styleClass="btn-secundario" onAction="#alternarPromocion"/>
        </VBox>
    </HBox>
</VBox>
