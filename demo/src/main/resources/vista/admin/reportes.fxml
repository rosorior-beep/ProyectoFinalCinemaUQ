<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.cinemauq.vistacontrolador.admin.ReportesVistaControlador"
      spacing="14" styleClass="seccion">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <Label text="Reportes" styleClass="titulo"/>
    <Label text="Selecciona el tipo de reporte y el periodo. Puedes exportarlo a PDF o a archivo de texto." styleClass="descripcion"/>
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Reporte"/>
        <ComboBox fx:id="cbTipo"/>
        <Label text="Desde"/>
        <DatePicker fx:id="dpDesde"/>
        <Label text="Hasta"/>
        <DatePicker fx:id="dpHasta"/>
        <Button text="Generar" styleClass="btn-primario" onAction="#generar"/>
        <Button text="Exportar PDF" styleClass="btn-secundario" onAction="#exportarPdf"/>
        <Button text="Exportar TXT" styleClass="btn-secundario" onAction="#exportarTxt"/>
    </HBox>
    <Label fx:id="lblEncabezado" styleClass="descripcion" wrapText="true"/>
    <TableView fx:id="tablaReporte" prefHeight="440" VBox.vgrow="ALWAYS">
        <placeholder><Label text="Genera un reporte para ver los resultados."/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
    <VBox spacing="10" styleClass="tarjeta">
        <Label text="Totales" styleClass="subtitulo"/>
        <GridPane fx:id="gridTotales" hgap="24" vgap="6"/>
    </VBox>
</VBox>
