<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.cinemauq.vistacontrolador.admin.PanelAdminVistaControlador"
            styleClass="fondo-app">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="encabezado">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Label fx:id="lblSaludo" styleClass="saludo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblPendientes" styleClass="chip, chip-dorado"/>
        </HBox>
    </top>
    <left>
        <VBox spacing="4" prefWidth="230" styleClass="sidebar">
            <padding><Insets top="20" right="12" bottom="20" left="12"/></padding>
            <VBox spacing="2">
                <padding><Insets bottom="18" left="8" right="8"/></padding>
                <Label text="CinemaUQ" styleClass="logo"/>
                <Label text="Administrador" styleClass="rol"/>
            </VBox>
            <Button fx:id="btnTablero" text="📊  Tablero" styleClass="nav-btn" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#mostrarTablero"/>
            <Button fx:id="btnPeliculas" text="🎬  Películas" styleClass="nav-btn" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#mostrarPeliculas"/>
            <Button fx:id="btnSalas" text="🪑  Salas y asientos" styleClass="nav-btn" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#mostrarSalas"/>
            <Button fx:id="btnFunciones" text="🕒  Funciones" styleClass="nav-btn" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#mostrarFunciones"/>
            <Button fx:id="btnConfiteria" text="🍿  Confitería y combos" styleClass="nav-btn" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#mostrarConfiteria"/>
            <Button fx:id="btnPromociones" text="🏷  Promociones" styleClass="nav-btn" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#mostrarPromociones"/>
            <Button fx:id="btnClientes" text="👥  Clientes y recargas" styleClass="nav-btn" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#mostrarClientes"/>
            <Button fx:id="btnCompras" text="🧾  Compras" styleClass="nav-btn" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#mostrarCompras"/>
            <Button fx:id="btnReportes" text="📄  Reportes" styleClass="nav-btn" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#mostrarReportes"/>
            <Button fx:id="btnHistorial" text="🕘  Historial de cambios" styleClass="nav-btn" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#mostrarHistorial"/>
            <Button fx:id="btnNotificaciones" text="🔔  Notificaciones" styleClass="nav-btn" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#mostrarNotificaciones"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="↺  Restaurar datos de demo" styleClass="nav-btn, nav-salir" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#restaurarDatos"/>
            <Button text="⏻  Cerrar sesión" styleClass="nav-btn, nav-salir" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#cerrarSesion"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fx:id="contenido" fitToWidth="true" fitToHeight="true" styleClass="contenido-scroll"/>
    </center>
</BorderPane>
