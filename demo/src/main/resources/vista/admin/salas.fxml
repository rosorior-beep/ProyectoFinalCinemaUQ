<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.cinemauq.vistacontrolador.admin.SalasVistaControlador"
      spacing="14" styleClass="seccion">
    <fx:define>
        <ToggleGroup fx:id="grupoHerramienta"/>
    </fx:define>
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <Label text="Salas y asientos" styleClass="titulo"/>
    <Label wrapText="true" styleClass="descripcion"
           text="Crea salas y edita sus asientos: selecciona una herramienta y haz clic sobre los asientos del mapa."/>
    <HBox spacing="16">
        <TableView fx:id="tablaSalas" prefHeight="220" HBox.hgrow="ALWAYS">
            <placeholder><Label text="No hay salas."/></placeholder>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colId" text="Id" prefWidth="60"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="130"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100"/>
                <TableColumn fx:id="colTamano" text="Filas x columnas" prefWidth="110"/>
                <TableColumn fx:id="colCapacidad" text="Capacidad" prefWidth="80"/>
            </columns>
        </TableView>
        <VBox spacing="10" prefWidth="340" minWidth="320" styleClass="tarjeta">
            <Label text="Nueva sala" styleClass="subtitulo"/>
            <GridPane hgap="10" vgap="8">
                <Label text="Nombre" styleClass="etiqueta-form" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS"/>
                <Label text="Tipo" styleClass="etiqueta-form" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cbTipo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Filas (máx 15)" styleClass="etiqueta-form" GridPane.rowIndex="2"/>
                <TextField fx:id="txtFilas" text="8" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Columnas (máx 20)" styleClass="etiqueta-form" GridPane.rowIndex="3"/>
                <TextField fx:id="txtColumnas" text="12" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="Filas preferenciales" styleClass="etiqueta-form" GridPane.rowIndex="4"/>
                <TextField fx:id="txtPreferenciales" text="GH" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <Label text="Asientos accesibles" styleClass="etiqueta-form" GridPane.rowIndex="5"/>
                <TextField fx:id="txtAccesibles" text="A1, A2" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            </GridPane>
            <Button text="Crear sala" styleClass="btn-primario" onAction="#crearSala"/>
        </VBox>
    </HBox>
    <VBox spacing="10" styleClass="tarjeta">
        <Label fx:id="lblEditor" text="Editor de asientos" styleClass="subtitulo"/>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Herramienta:"/>
            <RadioButton fx:id="rbGeneral" text="General" toggleGroup="$grupoHerramienta" selected="true"/>
            <RadioButton fx:id="rbPreferencial" text="Preferencial" toggleGroup="$grupoHerramienta"/>
            <RadioButton fx:id="rbAccesible" text="Accesible" toggleGroup="$grupoHerramienta"/>
            <RadioButton fx:id="rbHabilitar" text="Habilitar / deshabilitar" toggleGroup="$grupoHerramienta"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="↶  Deshacer último cambio" styleClass="btn-secundario" onAction="#deshacer"/>
        </HBox>
        <StackPane fx:id="contenedorMapa"/>
    </VBox>
</VBox>
