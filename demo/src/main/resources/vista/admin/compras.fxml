<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.cinemauq.vistacontrolador.admin.ComprasAdminVistaControlador"
      spacing="14" styleClass="seccion">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <Label text="Compras" styleClass="titulo"/>
    <Label text="Todas las compras registradas, de la más reciente a la más antigua." styleClass="descripcion"/>
    <TextField fx:id="txtFiltro" promptText="Buscar por id, cliente o película…"/>
    <TableView fx:id="tablaCompras" prefHeight="420" VBox.vgrow="ALWAYS">
        <placeholder><Label text="No hay compras."/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="Compra" prefWidth="80"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="130"/>
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="150"/>
            <TableColumn fx:id="colPelicula" text="Película" prefWidth="150"/>
            <TableColumn fx:id="colFuncion" text="Función" prefWidth="130"/>
            <TableColumn fx:id="colEntradas" text="Entradas" prefWidth="70"/>
            <TableColumn fx:id="colTotal" text="Total" prefWidth="100"/>
            <TableColumn fx:id="colPuntos" text="Puntos usados" prefWidth="90"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="90"/>
        </columns>
    </TableView>
    <VBox fx:id="panelDetalle" spacing="8" styleClass="tarjeta">
        <Label text="Selecciona una compra para ver el detalle." styleClass="descripcion"/>
    </VBox>
</VBox>
