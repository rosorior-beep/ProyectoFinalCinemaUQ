<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.cinemauq.vistacontrolador.admin.ConfiteriaVistaControlador"
      spacing="14" styleClass="seccion">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <Label text="Confitería y combos" styleClass="titulo"/>
    <Label wrapText="true" styleClass="descripcion"
           text="Un combo agrupa productos u otros combos (Composite); su precio es la suma de sus partes menos el descuento."/>
    <TableView fx:id="tablaProductos" prefHeight="300">
        <placeholder><Label text="No hay productos."/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="Id" prefWidth="70"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="160"/>
            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="90"/>
            <TableColumn fx:id="colContenido" text="Contenido" prefWidth="220"/>
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="90"/>
            <TableColumn fx:id="colPuntos" text="Puntos" prefWidth="70"/>
            <TableColumn fx:id="colDisponible" text="Disponible" prefWidth="80"/>
        </columns>
    </TableView>
    <HBox spacing="16">
        <VBox spacing="10" styleClass="tarjeta" HBox.hgrow="ALWAYS">
            <Label text="Nuevo producto" styleClass="subtitulo"/>
            <GridPane hgap="10" vgap="8">
                <Label text="Nombre" styleClass="etiqueta-form" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS"/>
                <Label text="Categoría" styleClass="etiqueta-form" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cbCategoria" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Precio $" styleClass="etiqueta-form" GridPane.rowIndex="2"/>
                <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Puntos para redimir" styleClass="etiqueta-form" GridPane.rowIndex="3"/>
                <TextField fx:id="txtPuntos" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane>
            <Button text="Crear producto" styleClass="btn-primario" onAction="#crearProducto"/>
        </VBox>
        <VBox spacing="10" styleClass="tarjeta" HBox.hgrow="ALWAYS">
            <Label text="Nuevo combo" styleClass="subtitulo"/>
            <GridPane hgap="10" vgap="8">
                <Label text="Nombre" styleClass="etiqueta-form" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNombreCombo" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS"/>
                <Label text="Descuento %" styleClass="etiqueta-form" GridPane.rowIndex="1"/>
                <TextField fx:id="txtDescuento" text="10" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Puntos para redimir" styleClass="etiqueta-form" GridPane.rowIndex="2"/>
                <TextField fx:id="txtPuntosCombo" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <ComboBox fx:id="cbComponente" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Agregar" styleClass="btn-secundario" onAction="#agregarComponente"/>
                <Button text="Quitar" styleClass="btn-secundario" onAction="#quitarComponente"/>
            </HBox>
            <ListView fx:id="listaComponentes" prefHeight="110"/>
            <Button text="Crear combo" styleClass="btn-primario" onAction="#crearCombo"/>
        </VBox>
        <VBox spacing="10" styleClass="tarjeta" HBox.hgrow="ALWAYS">
            <Label text="Editar seleccionado" styleClass="subtitulo"/>
            <GridPane hgap="10" vgap="8">
                <Label text="Nombre" styleClass="etiqueta-form" GridPane.rowIndex="0"/>
                <TextField fx:id="txtEditNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS"/>
                <Label text="Precio $" styleClass="etiqueta-form" GridPane.rowIndex="1"/>
                <TextField fx:id="txtEditPrecio" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Puntos" styleClass="etiqueta-form" GridPane.rowIndex="2"/>
                <TextField fx:id="txtEditPuntos" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <CheckBox fx:id="chkEditDisponible" text="Disponible para la venta" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane>
            <Label text="El precio de un combo se calcula automáticamente." styleClass="descripcion" wrapText="true"/>
            <Button text="Guardar cambios" styleClass="btn-primario" onAction="#guardarCambios"/>
        </VBox>
    </HBox>
</VBox>
