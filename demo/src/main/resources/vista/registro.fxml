<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.cinemauq.vistacontrolador.RegistroVistaControlador"
            styleClass="fondo-login">
    <center>
        <VBox alignment="CENTER">
            <VBox spacing="12" maxWidth="460" styleClass="tarjeta-login">
                <padding><Insets top="36" right="36" bottom="36" left="36"/></padding>
                <Label text="Crear cuenta" styleClass="titulo"/>
                <Label wrapText="true" styleClass="descripcion"
                       text="Al registrarte recibes una tarjeta virtual CinemaUQ. Para usarla, solicita una recarga desde &quot;Mi tarjeta&quot;."/>
                <GridPane hgap="10" vgap="8">
                    <Label text="Nombre" styleClass="etiqueta-form" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtNombre" promptText="Nombre completo" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>
                    <Label text="Documento" styleClass="etiqueta-form" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtDocumento" promptText="Solo números" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Correo" styleClass="etiqueta-form" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtEmail" promptText="correo@ejemplo.com" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Teléfono" styleClass="etiqueta-form" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtTelefono" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label text="Contraseña" styleClass="etiqueta-form" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="txtPassword" promptText="Mínimo 6 caracteres" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    <Label text="Confirmar" styleClass="etiqueta-form" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="txtConfirmacion" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>
                <Button text="Crear cuenta" styleClass="btn-primario" defaultButton="true" maxWidth="Infinity"
                        onAction="#registrar"/>
                <Hyperlink text="Ya tengo cuenta: iniciar sesión" onAction="#volver"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
